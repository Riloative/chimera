# Checks for Chimera updates once a day in a quiet window (04:00–05:00 local
# time by default). Change the window with: systemctl edit chimera-update.timer
#   [Timer]
#   OnCalendar=
#   OnCalendar=Sun *-*-* 03:00:00
[Unit]
Description=Daily Chimera update check

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target

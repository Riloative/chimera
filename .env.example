# Chimera configuration. Copy to .env and adjust. Every value is optional.

# --- Network -----------------------------------------------------------------
# Bind address. 127.0.0.1 = this machine only (recommended without a password).
CHIMERA_HOST=127.0.0.1
CHIMERA_PORT=8700

# --- Access control ----------------------------------------------------------
# Set a password to allow access from other devices (LAN / reverse proxy).
# Without it, only loopback clients are served.
# CHIMERA_PASSWORD=change-me-to-something-long

# Host names the browser may use to reach Chimera (DNS-rebinding protection).
# Defaults to loopback names without a password, and "*" with one.
# CHIMERA_ALLOWED_HOSTS=localhost,127.0.0.1,chimera.home.lan

# Serve non-loopback clients WITHOUT a password. Only for setups where something
# else restricts access (e.g. Docker publishing on 127.0.0.1 only).
# CHIMERA_ALLOW_UNAUTHENTICATED_REMOTE=false

# Set when serving over HTTPS (reverse proxy) so session cookies are Secure.
# CHIMERA_SECURE_COOKIES=false

# Session cookie signing key. Generated and stored in the data dir if unset.
# CHIMERA_SECRET_KEY=
# CHIMERA_SESSION_DAYS=30

# --- Storage -----------------------------------------------------------------
# Where the SQLite database, uploads and secret key live.
CHIMERA_DATA_DIR=./data

# --- Inference ---------------------------------------------------------------
# Connection created on first start (empty to skip). Manage connections in the UI.
CHIMERA_SEED_PROVIDER_URL=http://127.0.0.1:8080

# Route outbound provider requests through HTTP(S)_PROXY env vars.
# Off by default so local servers are always reached directly.
# CHIMERA_HTTP_TRUST_ENV=false

# --- Logging -----------------------------------------------------------------
# debug | info | warning | error. Message content is never logged.
CHIMERA_LOG_LEVEL=info

# --- Docker Compose only -----------------------------------------------------
# LLAMA_MODEL=qwen2.5-7b-instruct-q4_k_m.gguf
# LLAMA_CTX=8192

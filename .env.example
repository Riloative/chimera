# Chimera configuration. Copy to .env and adjust. Every value is optional.
# Real environment variables take precedence over this file.

# --- Network -----------------------------------------------------------------
# Bind address. 127.0.0.1 = this machine only. Use 0.0.0.0 for LAN access
# (then also set CHIMERA_ALLOWED_HOSTS and preferably HTTPS).
CHIMERA_HOST=127.0.0.1
CHIMERA_PORT=8700

# Host names the browser may use to reach Chimera (DNS-rebinding protection).
# Default: localhost, 127.0.0.1, ::1. Use "*" to disable the check.
# CHIMERA_ALLOWED_HOSTS=localhost,127.0.0.1,chimera.home.lan,192.168.1.20

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted
# (IPs or CIDRs). Leave empty unless Chimera is behind a proxy, otherwise clients
# could spoof their IP to evade rate limiting.
# CHIMERA_TRUSTED_PROXIES=127.0.0.1

# Extra origins allowed to call the API with credentials (CORS). Empty = same
# origin only, which is all the bundled web UI needs.
# CHIMERA_CORS_ORIGINS=

# --- Accounts ----------------------------------------------------------------
# Initial registration policy (admins can change it later in Settings → Users):
#   first_user_only  only the first account may self-register (it becomes admin)
#   closed           only admins create accounts
#   open             anyone who can reach the app may register
CHIMERA_REGISTRATION_MODE=first_user_only

# Optional secret required to create the very first (admin) account. Useful when
# the app is reachable by others before you finish setup.
# CHIMERA_SETUP_TOKEN=

# --- Sessions ----------------------------------------------------------------
# Idle timeout and absolute lifetime of a normal session, and the lifetime of a
# "keep me signed in" session.
CHIMERA_SESSION_IDLE_HOURS=12
CHIMERA_SESSION_ABSOLUTE_HOURS=168
CHIMERA_SESSION_REMEMBER_DAYS=30
# Secure cookie flag: auto (on when served over HTTPS, incl. via a trusted
# proxy), true, or false.
CHIMERA_COOKIE_SECURE=auto

# --- Brute-force protection --------------------------------------------------
# After N failures within the window an account is locked for the lockout time,
# doubling with each further failure (max 1 h). Per-IP limit = 4 × N.
CHIMERA_LOGIN_MAX_FAILURES=5
CHIMERA_LOGIN_WINDOW_MINUTES=15
CHIMERA_LOGIN_LOCKOUT_SECONDS=60
CHIMERA_REGISTER_PER_HOUR=10

# --- Secrets -----------------------------------------------------------------
# Key used to encrypt provider API keys at rest (Fernet, urlsafe base64, 32 bytes).
# If unset, one is generated in the data dir (.encryption_key, mode 0600).
# Keep it with your backups: without it stored API keys can't be decrypted.
# CHIMERA_ENCRYPTION_KEY=

# Argon2id password-hashing cost (RFC 9106 recommended defaults).
# CHIMERA_ARGON2_TIME_COST=3
# CHIMERA_ARGON2_MEMORY_KIB=65536
# CHIMERA_ARGON2_PARALLELISM=4

# --- Storage -----------------------------------------------------------------
# SQLite database, uploads, backups and key files.
CHIMERA_DATA_DIR=./data

# --- Inference ---------------------------------------------------------------
# Shared connection created for the first administrator (empty to skip).
CHIMERA_SEED_PROVIDER_URL=http://127.0.0.1:8080

# Route outbound provider requests through HTTP(S)_PROXY env vars.
# CHIMERA_HTTP_TRUST_ENV=false

# --- Web reading & search ----------------------------------------------------
# Initial values only: administrators change everything in Settings → Web (the
# database then wins). Nothing is fetched unless web access is enabled AND a
# user pastes a link or turns on search for a message. See docs/WEB.md.
# CHIMERA_WEB_ENABLED=false
# Self-hosted SearXNG (recommended). With the compose profile: http://searxng:8080
# CHIMERA_WEB_SEARXNG_URL=
# Internal hosts/CIDRs pages may be read from (private addresses are blocked
# otherwise), comma-separated, e.g. wiki.home.arpa,10.0.5.0/24
# CHIMERA_WEB_FETCH_ALLOWLIST=
# How this server identifies itself to websites.
# CHIMERA_WEB_USER_AGENT=Chimera/0.4 (self-hosted AI assistant; fetches pages on behalf of its users)
# Outbound proxy for web traffic only. Names are still resolved and checked
# locally, but the proxy makes the final connection (no DNS pinning).
# CHIMERA_WEB_PROXY=
# Log full URLs (may include secrets in query strings) instead of domains only.
# CHIMERA_WEB_VERBOSE_LOG=false
# Limits, timeouts, robots.txt, domain lists, per-user quotas, prompts and
# engine API keys (encrypted at rest) are set in the UI, not here.

# Secret for the optional SearXNG container (docker compose --profile searxng).
# Generate with: openssl rand -hex 32
# SEARXNG_SECRET=

# --- Headless browser (optional) ---------------------------------------------
# Renders pages that need JavaScript (docker compose --profile browser). Off
# unless both values are set. Administrators switch automatic rendering, the
# timeout and the per-user hourly limit in Settings → Web. See docs/WEB.md.
# With the compose profile:
# CHIMERA_BROWSER_URL=http://browser:3000
# Shared secret between Chimera and the browser service (at least 16
# characters; the service refuses to start without it). openssl rand -hex 32
# CHIMERA_BROWSER_SECRET=
# Where Chimera's egress filter proxy for the browser listens. The compose
# file sets 0.0.0.0:8701 inside the container (not published). Running both
# without Docker on one machine, keep the default.
# CHIMERA_BROWSER_PROXY_BIND=127.0.0.1:8701
# Pages rendered at once by the browser service (each needs ~100-300 MB RAM).
# BROWSER_MAX_PAGES=2

# --- Context window --------------------------------------------------------------
# Nothing to set here: llama-server reports its context size (per slot:
# -c divided by --parallel) and Chimera reads it. Strategy (leave out / summarize
# / off), the fallback size for other servers, and advanced options are per
# user in Settings → Chat; a per-connection override is under Models.

# --- Logging -----------------------------------------------------------------
# debug | info | warning | error. Message content, passwords and session tokens
# are never logged.
CHIMERA_LOG_LEVEL=info

# --- Docker Compose only -----------------------------------------------------
# LLAMA_MODEL=qwen2.5-7b-instruct-q4_k_m.gguf
# LLAMA_CTX=8192
